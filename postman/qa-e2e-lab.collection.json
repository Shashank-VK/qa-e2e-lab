{
  "info": {
    "_postman_id": "8a3dd7e5-28d1-4e1c-9d15-qae2elab001",
    "name": "QA E2E Lab API",
    "description": "API regression coverage for authentication and todo CRUD, including negative cases and JSON schema assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "todoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - valid credentials",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.response.to.have.jsonSchema({",
                  "    type: 'object',",
                  "    required: ['token', 'user'],",
                  "    properties: {",
                  "        token: { type: 'string', minLength: 1 },",
                  "        user: { type: 'object', required: ['id', 'email', 'name'] }",
                  "    }",
                  "});",
                  "pm.environment.set('authToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - invalid credentials",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa@example.com\",\n  \"password\": \"incorrect\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.response.to.have.jsonSchema({ type: 'object', required: ['error'], properties: { error: { type: 'string' } } });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Todos",
      "item": [
        {
          "name": "List todos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/todos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "todos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.response.to.have.jsonSchema({",
                  "    type: 'array',",
                  "    items: {",
                  "        type: 'object',",
                  "        required: ['id', 'title', 'completed', 'createdAt', 'updatedAt', 'userId'],",
                  "        properties: { id: { type: 'integer' }, title: { type: 'string' }, completed: { type: 'boolean' }, userId: { type: 'integer' } }",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create todo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Newman API regression item\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/todos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "todos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.response.to.have.jsonSchema({ type: 'object', required: ['id', 'title', 'completed'], properties: { id: { type: 'integer' }, title: { type: 'string' }, completed: { type: 'boolean' } } });",
                  "pm.environment.set('todoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get created todo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/todos/{{todoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "todos", "{{todoId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.response.to.have.jsonSchema({ type: 'object', required: ['id', 'title', 'completed'], properties: { id: { type: 'integer' }, title: { type: 'string' }, completed: { type: 'boolean' } } });",
                  "pm.test('Created title is returned', function () {",
                  "    pm.expect(pm.response.json().title).to.eql('Newman API regression item');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update todo",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Newman API item\",\n  \"completed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/todos/{{todoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "todos", "{{todoId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.response.to.have.jsonSchema({ type: 'object', required: ['id', 'title', 'completed'], properties: { title: { type: 'string' }, completed: { type: 'boolean' } } });",
                  "pm.test('Todo is updated', function () {",
                  "    pm.expect(pm.response.json().title).to.eql('Updated Newman API item');",
                  "    pm.expect(pm.response.json().completed).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete todo",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/todos/{{todoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "todos", "{{todoId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted todo returns 404",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/todos/{{todoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "todos", "{{todoId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.response.to.have.jsonSchema({ type: 'object', required: ['error'], properties: { error: { type: 'string' } } });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create todo rejects blank title",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"   \"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/todos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "todos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.response.to.have.jsonSchema({ type: 'object', required: ['error'], properties: { error: { type: 'string' } } });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorized list is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/todos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "todos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.response.to.have.jsonSchema({ type: 'object', required: ['error'], properties: { error: { type: 'string' } } });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
